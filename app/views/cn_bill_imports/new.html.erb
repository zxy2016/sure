<%= content_for :page_title, t(".title") %>
<%= content_for :previous_path, imports_path %>

<div class="space-y-6 mx-auto max-w-2xl">
  <div class="text-center space-y-2">
    <h1 class="text-3xl text-primary font-medium"><%= t(".title") %></h1>
    <p class="text-secondary text-sm"><%= t(".description") %></p>
  </div>

  <%= render DS::Alert.new(variant: :info, title: t(".how_title")) do %>
    <ol class="list-decimal pl-4 space-y-1 text-sm">
      <li><%= t(".how_wechat") %></li>
      <li><%= t(".how_alipay") %></li>
      <li><%= t(".how_cmb") %></li>
      <li><%= t(".how_ccb") %></li>
    </ol>
  <% end %>

  <%= styled_form_with url: cn_bill_imports_path, scope: :cn_bill, multipart: true, class: "space-y-4" do |form| %>
    <% CnBill::CHANNELS.each do |channel, config| %>
      <section class="rounded-xl border border-primary p-4 space-y-3 bg-container">
        <div class="flex items-center gap-2">
          <%= icon("file-up", size: "md", class: "text-secondary") %>
          <h2 class="text-primary font-medium"><%= t(".channels.#{channel}") %></h2>
          <span class="text-xs text-secondary"><%= config[:accept] %></span>
        </div>

        <%= form.file_field channel, accept: config[:accept] %>

        <label class="block text-sm text-secondary" for="cn_bill_accounts_<%= channel %>">
          <%= t(".target_account") %>
        </label>
        <%= select_tag "cn_bill_accounts[#{channel}]",
              options_from_collection_for_select(@accounts, :id, :name, @accounts.find { |a| a.name == config[:account_name] || a.name.start_with?(config[:account_name]) }&.id),
              include_blank: t(".auto_create", name: config[:account_name]),
              id: "cn_bill_accounts_#{channel}",
              class: "w-full rounded-lg border border-primary bg-container px-3 py-2 text-sm text-primary focus:outline-none focus:ring-2 focus:ring-gray-200" %>
      </section>
    <% end %>

    <p class="text-xs text-secondary"><%= t(".dedup_hint") %></p>

    <%= form.submit t(".submit") %>
  <% end %>
</div>
